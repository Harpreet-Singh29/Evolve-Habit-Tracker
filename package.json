{
  "name": "evolve-habit-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Evolve — a local-first habit tracker for the browser and Android",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "icons:android": "node scripts/sync-android-icons.mjs",
    "cap:clean": "node scripts/clean-cap-assets.mjs",
    "cap:sync": "npm run build && npx cap sync android && npm run cap:clean",
    "cap:add": "npx cap add android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sharp@0.32.6": true
  }
}
