<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- The whole scene (card, mountain, trail, checkpoints, labels) is rendered
         into a bitmap and pushed here, because RemoteViews has no canvas access. -->
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_description" />

    <!-- Kept for the "no items" label fallback; the bitmap draws the real text. -->
    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/widget_label_dark"
        android:visibility="gone" />

</FrameLayout>