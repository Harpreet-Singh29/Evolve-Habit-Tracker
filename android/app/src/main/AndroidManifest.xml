<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- Main activity - no LAUNCHER filter, aliases handle launcher entry -->
        </activity>

        <!-- Dynamic Icon Activity Aliases -->
        <!-- Only one should be enabled at a time via PackageManager -->
        <!-- Two states: Default (normal/complete) and Attention (incomplete due today) -->
        
        <!-- Default state (normal: all complete or nothing due) -->
        <activity-alias
            android:name=".launcher.DefaultIcon"
            android:targetActivity="com.harpreetsingh29.habittracker.MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Attention state (incomplete habits/tasks due today) -->
        <activity-alias
            android:name=".launcher.AttentionIcon"
            android:targetActivity="com.harpreetsingh29.habittracker.MainActivity"
            android:icon="@mipmap/ic_launcher_attention"
            android:roundIcon="@mipmap/ic_launcher_attention_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NOTE: deliberately no REQUEST_INSTALL_PACKAGES. Play Protect flags
         APKs that can install their own downloads, so updates are delivered
         by opening the GitHub release in the user's browser instead. -->
</manifest>
